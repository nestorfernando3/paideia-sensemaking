{
  "name": "paideia-sensemaking",
  "private": true,
  "version": "1.4.0",
  "description": "Παιδεία — Suite de herramientas pedagógicas inspirada en la filosofía griega",
  "license": "MIT",
  "author": "Nestor Fernando De Leon Llanos",
  "homepage": "https://github.com/nestorfernando3/paideia-sensemaking",
  "bugs": {
    "url": "https://github.com/nestorfernando3/paideia-sensemaking/issues"
  },
  "keywords": [
    "education",
    "edtech",
    "classroom",
    "pedagogy",
    "supabase",
    "realtime",
    "vite",
    "github-pages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nestorfernando3/paideia-sensemaking.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:edge": "deno test --allow-env --allow-net supabase/functions/paideia-ai/tests",
    "test:db": "supabase test db",
    "verify": "npm run test && npm run build",
    "serve:local": "node server/index.mjs",
    "start:local": "npm run build && node server/index.mjs",
    "electron:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "supabase": "^2.39.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "canvas-confetti": "^1.9.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.paideia.app",
    "productName": "Paideia Local",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*"
    ],
    "mac": {
      "target": "zip",
      "icon": "public/favicon.ico"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "publish": [
      "github"
    ]
  }
}
